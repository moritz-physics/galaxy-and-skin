# Python-generated files
__pycache__/
*.pyc
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv/

# Galaxy data (large, not tracked)
galaxy/data/

# Galaxy results — everything except tracked figures
galaxy/results/*
!galaxy/results/figures/

# Skin sub-project: data subset and trained model artefacts (large, not tracked),
# but keep the analysis figures (small, regenerable, useful in the repo)
skin/data/
skin/results/*
!skin/results/figures/
# Architecture-selection & HPO decision records: track the small JSON/PNG/MD only
# (not checkpoints *.pt, Optuna DBs *.db, or verbose Kaggle *.log).
!skin/results/bakeoff/
!skin/results/hpo/
skin/results/bakeoff/**
skin/results/hpo/**
!skin/results/bakeoff/**/
!skin/results/hpo/**/
!skin/results/bakeoff/**/*.json
!skin/results/bakeoff/**/*.png
!skin/results/bakeoff/**/*.md
!skin/results/hpo/**/*.json
!skin/results/hpo/**/*.png
!skin/results/hpo/**/*.md

# Weights & Biases local run cache
wandb/

# Notebooks
.ipynb_checkpoints/

# OS
.DS_Store
